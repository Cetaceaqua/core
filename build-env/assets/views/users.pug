extends _layout.pug

block content
  section.section.is-main-section
    if formMessage
      if formMessage.danger
        .notification.is-danger.is-light #{formMessage.message}
      else
        .notification.is-success.is-light #{formMessage.message}

    .card
      header.card-header
        p.card-header-title
          span.icon
            i.mdi.mdi-account-group
          | User Management
      .card-content
        .table-container
          table.table.is-fullwidth.is-striped.is-hoverable
            thead
              tr
                th Username
                th Card Number
                th Role
                th Actions
            tbody
              if !users || users.length === 0
                tr
                  td.has-text-centered(colspan=4) No users found.
              else
                each account in users
                  tr
                    td #{account.username}
                    td #{account.cardNumber || '-'}
                    td
                      if account.admin
                        span.tag.is-info Admin
                      else
                        span.tag.is-light User
                    td
                      if account.username !== user
                        .buttons
                          form(method="post" action="/users/toggle-admin" style="display:inline")
                            input(type="hidden" name="username" value=account.username)
                            if account.admin
                              button.button.is-small.is-warning.is-light(type="submit" data-tooltip="Remove Admin")
                                span.icon.is-small
                                  i.mdi.mdi-shield-remove
                            else
                              button.button.is-small.is-success.is-light(type="submit" data-tooltip="Make Admin")
                                span.icon.is-small
                                  i.mdi.mdi-shield-plus
                          form(method="post" action="/users/delete" onsubmit="return confirm('Are you sure you want to delete this user account?');" style="display:inline")
                            input(type="hidden" name="username" value=account.username)
                            button.button.is-small.is-danger.is-light(type="submit" data-tooltip="Delete User")
                              span.icon.is-small
                                i.mdi.mdi-trash-can
