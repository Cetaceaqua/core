extends _layout.pug

block content
  section.section.is-main-section
    if formMessage
      if formMessage.danger
        .notification.is-danger.is-light #{formMessage.message}
      else
        .notification.is-success.is-light #{formMessage.message}

    .columns
      .column.is-12
        .card.mb-6
          header.card-header
            p.card-header-title
              span.icon
                i.mdi.mdi-gamepad-variant
              | Cabinet Management
          .card-content
            form(method="post" action="/cabinets/new")
              .field.has-addons
                if isAdmin
                  .control
                    input.input(type="text" name="targetUsername" placeholder="Target User (optional)")
                .control.is-expanded
                  input.input(type="text" name="name" placeholder="Cabinet Name (e.g. Local Machine)" required)
                .control
                  button.button.is-info(type="submit")
                    span.icon
                      i.mdi.mdi-plus
                    span Add Cabinet

            .table-container.mt-5
              table.table.is-fullwidth.is-striped.is-hoverable
                thead
                  tr
                    th Cabinet Name
                    th PCBID
                    if isAdmin
                      th Owner
                    th Last Seen
                    th Actions
                tbody
                  if !cabinets || cabinets.length === 0
                    tr
                      td.has-text-centered(colspan=isAdmin ? 5 : 4) No cabinets registered.
                  else
                    each cab in cabinets
                      tr
                        td #{cab.name}
                        td
                          code #{cab.pcbid}
                        if isAdmin
                          td
                            span.tag.is-light #{cab.username}
                        td
                          if !cab.lastSeen || cab.lastSeen === 0
                            span.has-text-grey Never
                          else
                            - var date = new Date(cab.lastSeen)
                            | #{date.toLocaleString()}
                        td
                          .buttons
                            button.button.is-small.is-warning.is-light(type="button" onclick=`renameCabinet('${cab.pcbid}', '${cab.name}')` data-tooltip="Rename")
                              span.icon.is-small
                                i.mdi.mdi-pencil
                            form(method="post" action="/cabinets/delete" onsubmit="return confirm('Are you sure you want to delete this cabinet?');" style="display:inline;")
                              input(type="hidden" name="pcbid" value=cab.pcbid)
                              button.button.is-small.is-danger.is-light(type="submit" data-tooltip="Delete")
                                span.icon.is-small
                                  i.mdi.mdi-trash-can

    form#rename-form(method="post" action="/cabinets/rename" style="display:none")
      input#rename-pcbid(type="hidden" name="pcbid")
      input#rename-name(type="hidden" name="name")

block scripts
  script.
    function renameCabinet(pcbid, currentName) {
      var newName = prompt('Enter new cabinet name:', currentName);
      if (newName && newName.trim() !== '' && newName !== currentName) {
        document.getElementById('rename-pcbid').value = pcbid;
        document.getElementById('rename-name').value = newName.trim();
        document.getElementById('rename-form').submit();
      }
    }
