doctype html
html
  head
    meta(charset="utf-8")
    meta(http-equiv="X-UA-Compatible", content="ie=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0")
    title Asphyxia CORE - Sign Up
    link(rel="stylesheet", href="/static/css/bulma.min.css")
    link(rel="stylesheet", href="/static/css/margin.min.css")
    link(rel="stylesheet", href="/static/css/materialdesignicons.min.css")
    link(rel="stylesheet", href="/static/css/style.css")
    link(rel="stylesheet", href="/static/css/bulma-fix.css")
  body
    section.hero.is-fullheight
      .hero-body
        .container
          .columns.is-centered
            .column.is-5-tablet.is-4-desktop.is-3-widescreen
              .card
                .card-content
                  .has-text-centered.mb-5
                    .image.is-64x64.logo(style="margin: 0 auto 1rem auto;")
                      img(src="/static/img/logo.png")
                    h1.title.is-4 Asphyxia CORE
                  if error
                    .notification.is-danger.is-light.mb-4 #{error}
                  form(method="post" action="/signup")
                    .field
                      label.label Username
                      .control.has-icons-left
                        input.input(type="text" name="username" placeholder="Username" required autofocus value=(old && old.username ? old.username : ''))
                        span.icon.is-small.is-left
                          i.mdi.mdi-account
                    .field
                      label.label Card Number
                      .control.has-icons-left
                        input.input(type="text" name="cardNumber" placeholder="16-character Card Number" required value=(old && old.cardNumber ? old.cardNumber : ''))
                        span.icon.is-small.is-left
                          i.mdi.mdi-credit-card-outline
                    .field
                      label.label Password
                      .control.has-icons-left
                        input.input(type="password" name="password" placeholder="Password" required value=(old && old.password ? old.password : ''))
                        span.icon.is-small.is-left
                          i.mdi.mdi-lock
                    .field
                      label.label Confirm Password
                      .control.has-icons-left
                        input.input(type="password" name="confirmPassword" placeholder="Confirm Password" required value=(old && old.confirmPassword ? old.confirmPassword : ''))
                        span.icon.is-small.is-left
                          i.mdi.mdi-lock-check
                    .field.mt-4
                      button.button.is-info.is-fullwidth(type="submit")
                        span.icon
                          i.mdi.mdi-account-plus
                        span Sign Up
                  hr
                  .has-text-centered
                    p.is-size-7.has-text-grey
                      | Already have an account?&nbsp;
                      a(href="/login") Login
